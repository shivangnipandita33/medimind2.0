# Copy this file to .env and add your key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here
# Optional: first model to try. If it fails the app automatically tries gemini-flash-latest, gemini-flash-lite-latest and gemini-2.5-flash.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Extra frontend URL(s) allowed to call this API (comma separated), e.g. your deployed site:
# ALLOWED_ORIGINS=https://medimind.example.com
# Optional. Every SOS alert is POSTed here as JSON (Twilio Function, Zapier, n8n, ...):
# SOS_WEBHOOK_URL=https://example.com/sos-hook
